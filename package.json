{
    "name": "@obusk/warcraftlogs-search",
    "private": true,
    "version": "",
    "type": "module",
    "description": "Thing to try to find rankings on Warcraftlogs",
    "keywords": [
        "warcraftlogs",
        "wcl",
        "world of warcraft",
        "wow",
        "wowanalyzer"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oBusk/warcraftlogs-search.git"
    },
    "author": "Oscar Busk <oscar.busk@gmail.com>",
    "license": "ISC",
    "engines": {
        "node": "24.x"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.18.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@11.17.0",
    "simple-git-hooks": {
        "pre-commit": "pnpm run lint-staged"
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx,mjs,cjs}": [
            "oxlint --fix",
            "oxfmt"
        ],
        "**/*.{css,md,yml,yaml,json}": [
            "oxfmt"
        ]
    },
    "scripts": {
        "dev": "next dev --turbopack -p 3001",
        "build": "next build",
        "start": "next start -p 3001",
        "lint": "oxlint",
        "postlint": "pnpm run format-check",
        "lint-fix": "oxlint --fix",
        "postlint-fix": "pnpm run format",
        "format": "oxfmt",
        "format-check": "oxfmt --check",
        "lint-staged": "lint-staged",
        "test": "jest",
        "test-ci": "jest --ci"
    },
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "downshift": "^9.4.0",
        "lucide-react": "^0.563.0",
        "next": "16.2.12",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwind-merge": "^2.6.1"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "~7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/eslint-plugin-tailwindcss": "^3.17.0",
        "@types/jest": "^30.0.0",
        "@types/node": "24.10.2",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "autoprefixer": "^10.5.4",
        "babel-plugin-react-compiler": "^1.0.0",
        "encoding": "^0.1.13",
        "eslint-plugin-tailwindcss": "^3.18.3",
        "eslint-plugin-testing-library": "^7.16.2",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "lint-staged": "^17.2.0",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "postcss": "^8.5.23",
        "simple-git-hooks": "^2.13.1",
        "tailwindcss": "^3.4.19",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
    }
}
