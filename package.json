{
    "name": "@obusk/warcraftlogs-search",
    "private": true,
    "version": "",
    "type": "module",
    "description": "Thing to try to find rankings on Warcraftlogs",
    "keywords": [
        "warcraftlogs",
        "wcl",
        "world of warcraft",
        "wow",
        "wowanalyzer"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oBusk/warcraftlogs-search.git"
    },
    "author": "Oscar Busk <oscar.busk@gmail.com>",
    "license": "ISC",
    "engines": {
        "node": "24.x"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.19.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.6.0",
    "simple-git-hooks": {
        "pre-commit": "pnpm run lint-staged"
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx,mjs,cjs}": [
            "eslint --fix"
        ],
        "**/*.{css,md,yml,yaml,json}": [
            "prettier --write"
        ]
    },
    "scripts": {
        "dev": "next dev --turbopack -p 3001",
        "build": "next build",
        "start": "next start -p 3001",
        "typegen": "next typegen",
        "prelint": "pnpm run typegen",
        "lint": "eslint .",
        "postlint": "pnpm run prettier",
        "lint-fix": "eslint --fix .",
        "postlint-fix": "pnpm run prettier-fix",
        "prettier": "prettier **/*.{css,md,yml,yaml,json} --ignore-path .gitignore --ignore-path .prettierignore --check",
        "prettier-fix": "prettier **/*.{css,md,yml,yaml,json} --ignore-path .gitignore --ignore-path .prettierignore --write",
        "lint-staged": "lint-staged",
        "test": "jest",
        "test-ci": "jest --ci"
    },
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "downshift": "^9.4.0",
        "lucide-react": "^0.577.0",
        "next": "16.3.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@obusk/eslint-config-next": "^16.3.4",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "~7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "24.10.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "encoding": "^0.1.13",
        "eslint": "^10.11.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "lint-staged": "^17.5.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "simple-git-hooks": "^2.14.0",
        "tailwindcss": "^4.3.3",
        "ts-node": "^10.9.2",
        "typescript": "~7.0.2"
    }
}
