{
    "permissions": {
        "deny": [
            "Read(/.env)",
            "Read(/.env.local)",
            "Read(/.vercel/.env.development.local)"
        ],
        "ask": [
            "Bash(vercel)",
            "Bash(vercel *)",
            "Bash(vercel deploy)",
            "Bash(vercel deploy *)",
            "Bash(vercel --prod)",
            "Bash(vercel --prod *)",
            "Bash(vercel env *)"
        ]
    }
}
